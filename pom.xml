<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.josemanuel</groupId>
    <artifactId>maven-by-jmmendoza</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Maven Tutorial by Jose Manuel</name>

    <modules>
        <module>modules/project-bom</module>
        <module>modules/lib-old</module>
        <module>modules/lib-new</module>
        <module>modules/app-cli</module>
        <module>modules/dist</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!-- Dependency versions (BOM consumes these) -->
        <commons-lang3.old.version>3.10.0</commons-lang3.old.version>
        <commons-lang3.new.version>3.12.0</commons-lang3.new.version>
        <slf4j.version>2.0.9</slf4j.version>
        <junit.jupiter.version>5.10.1</junit.jupiter.version>
        <jakarta.servlet.version>5.0.0</jakarta.servlet.version>
        <system.helpers.version>1.0</system.helpers.version>

        <!-- Plugin versions -->
        <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
        <maven.jar.plugin.version>3.3.0</maven.jar.plugin.version>
        <maven.shade.plugin.version>3.5.2</maven.shade.plugin.version>
        <maven.dependency.plugin.version>3.6.1</maven.dependency.plugin.version>
        <maven.assembly.plugin.version>3.6.0</maven.assembly.plugin.version>
        <maven.enforcer.plugin.version>3.3.0</maven.enforcer.plugin.version>

        <!-- Default expected version for the didactic test (conflict mode) -->
        <expected.commons.lang3.version>${commons-lang3.old.version}</expected.commons.lang3.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Manage internal module versions in one place -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>lib-old</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>lib-new</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Compiler settings for all modules (bound to compile/test-compile) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

                <!-- Surefire runs unit tests in the test phase -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <expected.commons.lang3.version>${expected.commons.lang3.version}</expected.commons.lang3.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <!-- Standard JAR creation in the package phase -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin.version}</version>
                </plugin>

                <!-- Creates an executable fat JAR in the package phase -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.plugin.version}</version>
                </plugin>

                <!-- Copies dependency JARs to target/lib during prepare-package -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven.dependency.plugin.version}</version>
                </plugin>

                <!-- Builds the tar.gz distribution in the package phase -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven.assembly.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Compiler plugin configuration inherited by all modules (compile/test-compile) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- Surefire runs unit tests in the test phase -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- Enforces Maven/Java versions and dependency hygiene in validate -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-base-rules</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.8.1,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <banDuplicatePomDependencyVersions />
                            </rules>
                            <failFast>true</failFast>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Default conflict mode (no forced version) -->
        <profile>
            <id>conflict</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <expected.commons.lang3.version>${commons-lang3.old.version}</expected.commons.lang3.version>
            </properties>
        </profile>

        <!-- Fixed mode forces a single commons-lang3 version across the graph -->
        <profile>
            <id>fixed</id>
            <properties>
                <expected.commons.lang3.version>${commons-lang3.new.version}</expected.commons.lang3.version>
            </properties>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.commons</groupId>
                        <artifactId>commons-lang3</artifactId>
                        <version>${commons-lang3.new.version}</version>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>

        <!-- Demonstrates how exclusions block a transitive dependency -->
        <profile>
            <id>exclude-old-lang3</id>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>${project.groupId}</groupId>
                        <artifactId>lib-old</artifactId>
                        <version>${project.version}</version>
                        <exclusions>
                            <exclusion>
                                <groupId>org.apache.commons</groupId>
                                <artifactId>commons-lang3</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>

        <!-- Release profile bans SNAPSHOT dependencies -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven.enforcer.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>ban-snapshots</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <banSnapshots>
                                            <message>No SNAPSHOT dependencies allowed in release builds.</message>
                                        </banSnapshots>
                                    </rules>
                                    <failFast>true</failFast>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
